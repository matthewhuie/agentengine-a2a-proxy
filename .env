GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=

# Path to the GCP service account JSON key file used to obtain OIDC tokens
# for AWS STS federation. Leave unset to use Application Default Credentials.
GOOGLE_APPLICATION_CREDENTIALS=

# AWS Bedrock AgentCore A2A endpoint, e.g.:
#   https://<runtime-id>.agentcore.<region>.amazonaws.com
A2A_AGENT_URL=

# ARN of the AWS IAM role that the GCP service account is allowed to assume
# via AssumeRoleWithWebIdentity, e.g.:
#   arn:aws:iam::123456789012:role/GCPBedrockAgentCoreRole
AWS_ROLE_ARN=

# AWS region where Bedrock AgentCore is deployed
AWS_REGION=us-east-1

# SigV4 service signing name for Bedrock AgentCore.
# Override if AWS uses a different signing name (e.g. bedrock-agentcore).
AWS_SERVICE=bedrock
